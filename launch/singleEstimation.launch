<?xml version="1.0"?>
<launch>
        <arg name="vehicle" default="MAV"/>
        <arg name="consensus" default="false"/>
        <arg name="rate" default="50"/>
        <arg name="fusionNum" default="0"/>
        <arg name="stateSize" default="6"/>
        <param name="mavNum" value="1"/>

        <group ns="$(arg vehicle)2">
                <param name="ID" value="2" />
                <param name="stateSize" value="$(arg stateSize)"/>
                <param name="vehicle" value="$(arg vehicle)" />
                <param name="rate" value="$(arg rate)"/>
                <param name="consensus" value="$(arg consensus)"/>
                <param name="pos_est" value="true"/>

                <node name="single_est" pkg="state_estimation" type="single_est" output="screen" ></node>
        </group>
</launch>